{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vndb-ranking",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-01",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vndb",
			"database_id": "bf6d402c-dfc5-47f4-9718-ed4a95e8a6e0"
		}
	],
	"observability": {
		"enabled": true
	},
	"routes": [{ 
		"pattern": "vndb.mojimoon.top", 
		"custom_domain": true 
	}]
}