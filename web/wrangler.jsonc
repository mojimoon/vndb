{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vndb-ranking",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Built SPA; unknown paths fall back to index.html, /api/* goes to the worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vndb",
      // Replace with the id printed by `npx wrangler d1 create vndb`.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": { "enabled": true }
  // To serve on your own domain, uncomment and edit:
  // "routes": [{ "pattern": "vndb.example.com", "custom_domain": true }]
}
